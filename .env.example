# Keep the real file outside Git, e.g. /etc/sechenov-volley-bot.env (chmod 600).
TELEGRAM_BOT_TOKEN=replace_with_existing_telegram_token
BOT_GITHUB_TOKEN=replace_with_new_um1ra_volley_repository_token
OWNER_SETUP_SECRET=replace_with_existing_owner_setup_secret
# WEBHOOK_SECRET is unused in polling mode.
GITHUB_REPO=um1ra-volley/sechenov-volley-bot
DATA_BRANCH=codex/bot-data
RUNTIME_ID=server-primary
RUNTIME_EPOCH=1
