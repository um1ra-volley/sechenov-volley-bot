{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "google-apps-script"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.ts"
  ]
}
